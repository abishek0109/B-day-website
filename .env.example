# =========================================================================
# A LITTLE BOOK OF YOU — ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to '.env' and insert your Supabase project credentials.
#
# Owner administration and public wish submissions require a configured
# Supabase project. No frontend-only password fallback is used.
# =========================================================================

# 1. Your Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
# Safe to use in client applications because Row Level Security (RLS) protects data!
VITE_SUPABASE_ANON_KEY=your-anon-key
